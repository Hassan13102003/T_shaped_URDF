<?xml version="1.0"?>
<!-- https://wiki.ros.org/urdf/XML/link --> 
<robot name="simple_robot">

<link name="base_link">
    <visual>
        <geometry>
            <cylinder radius="0.1" length="1"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.01"/>
        <material name="green">
            <color rgba="0.0 1.0 0.0 1.0"/>
        </material>
    </visual>
</link>

<joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="first_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.05"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-1.2" upper="1.2" effort="300" velocity="2.0"/>
</joint>

<link name="first_link">
    <visual>
        <geometry>
            <cylinder radius="0.5" length="0.08"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.5"/>
        <material name="yellow">
            <color rgba="1.0 1.0 0.0 1.0"/>
        </material>
    </visual>  
</link>

<joint name="joint_2" type="prismatic">
    <parent link="first_link"/>
    <child link="second_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.5"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-2.0" upper="2.0" effort="300" velocity="2.0"/>
</joint>

<link name="second_link">
    <visual>
        <geometry>
            <box size="0.2 0.7 0.1"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.01"/>
        <material name="red">
            <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
    </visual>
</link>

</robot>
